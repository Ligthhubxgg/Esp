-- 15-SECOND LOOP KILL ALL
killAllBtn.MouseButton1Click:Connect(function()
	if not isInGame() or not isLocalMurderer() then return end
	
	killAllBtn.Text = "KILLING..."
	task.spawn(function()
		local startTime = os.clock()
		while (os.clock() - startTime) < 15 and isInGame() do
			local myChar = localPlayer.Character
			local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
			if not myRoot then break end

			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= localPlayer and p.Character then
					local targetRoot = p.Character:FindFirstChild("HumanoidRootPart")
					local targetHumanoid = p.Character:FindFirstChildOfClass("Humanoid")
					if targetRoot and targetHumanoid and targetHumanoid.Health > 0 then
						pcall(function()
							myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 1.2)
						end)
						task.wait(0.15)
					end
				end
			end
			task.wait(0.1)
		end
		killAllBtn.Text = "EXECUTE"
	end)
end)

-- Render Loop
RunService.RenderStepped:Connect(function()
	if not isInGame() then return end
	
	-- Role ESP
	if espEnabled then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= localPlayer and p.Character then
				local char = p.Character
				if char:FindFirstChildOfClass("Humanoid") then
					local hl = char:FindFirstChild("LightHub_RoleESP")
					if not hl then
						hl = Instance.new("Highlight")
						hl.Name = "LightHub_RoleESP"
						hl.Adornee = char
						hl.Parent = char
					end
					hl.FillColor = getPlayerRoleColor(p)
					hl.OutlineColor = Color3.fromRGB(255, 255, 255)
					hl.FillTransparency = 0.5
				end
			end
		end
	end
	
	-- Sheriff Aimbot
	if aimbotEnabled and isLocalSheriff() then
		local targetMurderer = nil
		local shortestDistance = math.huge
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 and getPlayerRole(p) == "Murderer" then
					local distance = (p.Character.HumanoidRootPart.Position - localPlayer.Character.HumanoidRootPart.Position).Magnitude
					if distance < shortestDistance then
						shortestDistance = distance
						targetMurderer = p
					end
				end
			end
		end
		if targetMurderer and targetMurderer.Character and targetMurderer.Character:FindFirstChild("HumanoidRootPart") then
			local targetPart = targetMurderer.Character.HumanoidRootPart
			local myRoot = localPlayer.Character.HumanoidRootPart
			camera.CFrame = CFrame.new(camera.CFrame.Position, targetPart.Position)
			myRoot.CFrame = CFrame.new(myRoot.Position, Vector3.new(targetPart.Position.X, myRoot.Position.Y, targetPart.Position.Z))
		end
	end
end)

