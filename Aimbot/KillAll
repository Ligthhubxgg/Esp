local espEnabled = false
local aimbotEnabled = false

local function getPlayerRole(p)
	local char = p.Character
	local backpack = p:FindFirstChildOfClass("Backpack")
	
	local containers = {char, backpack}
	for _, containerRef in ipairs(containers) do
		if containerRef then
			for _, item in ipairs(containerRef:GetChildren()) do
				if item:IsA("Tool") then
					local tName = string.lower(item.Name)
					if string.find(tName, "gun") or string.find(tName, "revolver") or string.find(tName, "sheriff") then
						return "Sheriff"
					elseif string.find(tName, "knife") or string.find(tName, "blade") or string.find(tName, "dagger") or string.find(tName, "corrupt") then
						return "Murderer"
					end
				end
			end
		end
	end
	
	if p:GetAttribute("Role") then
		local attrRole = string.lower(tostring(p:GetAttribute("Role")))
		if string.find(attrRole, "murder") then return "Murderer" end
		if string.find(attrRole, "sheriff") then return "Sheriff" end
	end
	
	return "Innocent"
end

local function getPlayerRoleColor(p)
	local role = getPlayerRole(p)
	if role == "Sheriff" then
		return Color3.fromRGB(0, 120, 255)
	elseif role == "Murderer" then
		return Color3.fromRGB(255, 50, 50)
	end
	return Color3.fromRGB(0, 255, 0)
end

local function isLocalSheriff()
	if not isInGame() then return false end
	return getPlayerRole(localPlayer) == "Sheriff"
end

local function isLocalMurderer()
	if not isInGame() then return false end
	return getPlayerRole(localPlayer) == "Murderer"
end

